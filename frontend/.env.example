# ==============================================================================
# SMART CITY COMPLAINT MANAGEMENT SYSTEM - FRONTEND CONFIGURATION (EXAMPLE)
# Copy this file to .env.local for custom local settings, or configure these
# environment variables in the Cloudflare Pages build dashboard.
#
# NOTE: All variables prefixed with 'VITE_' are embedded into client bundles
# at build time and are publicly visible. NEVER store private secrets here.
# ==============================================================================

# API Base URL:
# - In local development: Leave default "/api/v1" to leverage Vite's local dev proxy to 127.0.0.1:8000.
# - In Cloudflare Pages deployment: Set to the full backend URL (including /api/v1).
# Example: VITE_API_BASE_URL="https://smart-city-complaint-management-kcao.onrender.com/api/v1"
VITE_API_BASE_URL="/api/v1"

# Supabase Project URL:
# Used for public authentication redirects (e.g. Google OAuth sign-in flow).
# Example: VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_URL="https://sagibkveeaciobapkgrt.supabase.co"
