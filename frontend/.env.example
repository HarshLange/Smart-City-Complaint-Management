# ==============================================================================
# SMART CITY COMPLAINT MANAGEMENT SYSTEM - FRONTEND CONFIGURATION (EXAMPLE)
# Copy this file to .env.local if custom client configuration is required.
# In local development, Vite proxies '/api' to 'http://127.0.0.1:8000' automatically.
# ==============================================================================

# API Base URL (Leave empty or default to use Vite dev proxy '/api/v1')
VITE_API_BASE_URL="/api/v1"

# Production API Endpoint (When frontend and backend are hosted on different origins)
# VITE_API_BASE_URL="https://api.smartcity.gov/api/v1"
