# ==============================================================================
# SMART CITY COMPLAINT MANAGEMENT SYSTEM - BACKEND CONFIGURATION (.env.example)
#
# LOCAL DEV: Copy this file to backend/.env and customize.
# CLOUD RUN: Pass these as Cloud Run Environment Variables / Secret Manager secrets.
#            Do NOT bake .env files into container images (enforced by .dockerignore).
# ==============================================================================

# Application Metadata
PROJECT_NAME="Smart City Complaint Management System"
ENVIRONMENT="development"       # "development" | "staging" | "production"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Security & Authentication
# Generate a secure 64-char key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="generate-and-set-a-secure-random-secret-key-here-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=180

# Cookie Security (Set COOKIE_SECURE=true when deployed behind HTTPS on Cloud Run)
COOKIE_SECURE=false             # false for local HTTP; true for Cloud Run / HTTPS
COOKIE_SAMESITE="lax"

# Database Configuration
# Supabase PostgreSQL via Session Pooler (port 5432 - Recommended for asyncpg):
# DATABASE_URL="postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
#
# Supabase PostgreSQL via Transaction Pooler (port 6543 - Requires disabling statement cache):
# DATABASE_URL="postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?statement_cache_size=0"
#
# Local SQLite Async (Zero-dependency Local Dev & Automated Testing):
DATABASE_URL="sqlite+aiosqlite:///./smart_city.db"

# Supabase Storage & Services (Server-Side Only - NEVER expose service role key to frontend)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"
SUPABASE_STORAGE_BUCKET="complaint-images"

# Storage Backend Mode: 'supabase' (Cloud Run demo/prod) or 'local' (isolated disk storage)
STORAGE_BACKEND="supabase"
LOCAL_STORAGE_DIR="storage/uploads"

# AI Inference & Routing
AI_MODEL_PATH="app/ml/weights/best_model.pt"
AI_METADATA_PATH="app/ml/weights/model_metadata.json"
AI_CONFIDENCE_THRESHOLD=0.80
MAX_INFERENCE_WORKERS=2

# Upload Security & Validation
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=["image/jpeg", "image/png", "image/webp"]

# CORS Configuration
# Accepts either a JSON array string:
#   ALLOWED_CORS_ORIGINS='["https://civicpulse.infalex.com", "https://project.infalex.com", "http://localhost:5173"]'
# Or a comma-separated list:
#   ALLOWED_CORS_ORIGINS="https://civicpulse.infalex.com,https://project.infalex.com,http://localhost:5173"
ALLOWED_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

# Bootstrap Initial Administrator
INITIAL_ADMIN_EMAIL="admin@smartcity.gov"
INITIAL_ADMIN_NAME="Municipal System Administrator"
INITIAL_ADMIN_PASSWORD="SecureBootstrapAdminPass2026!"
